modules = ["python-base-3.13"]

[nix]
channel = "stable-25_05"
packages = ["libxcrypt", "unixODBC", "xcbuild", "zstd", "mesa", "libglvnd", "libxkbcommon", "fontconfig", "dbus", "xcb-util-cursor", "xorg.xcbutil", "xorg.xcbutilimage", "xorg.xcbutilkeysyms", "xorg.xcbutilrenderutil", "xorg.xcbutilwm", "xorg.libxcb", "xorg.libX11"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "vnc"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "uv run python main.py"
